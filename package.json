{
  "name": "mgw-gui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local_development",
    "build": "ng build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "check:icons": "node scripts/check-icon-subset.mjs",
    "icons:list": "node -e \"import('./scripts/icon-usage.mjs').then(m=>{const r=m.findIcons();console.log([...new Set([...r.certain.keys(),...r.possible.keys()])].sort().join('\\n'))})\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.20",
    "@angular/platform-browser-dynamic": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@sentry/angular": "^10.70.0",
    "ansi_up": "^6.0.6",
    "rxjs": "~7.8.0",
    "semver": "^7.5.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "~21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@angular/localize": "^21.2.20",
    "@eslint/js": "^10.0.1",
    "@types/semver": "^7.5.6",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.11"
  }
}

# Quality gate configuration for mgw-gui.
# Modes per gate: off | observe | warn | enforce. Every mode below enforce
# carries a date and a reason. Confirmed 2026-08-19 during the next-gen UI
# migration.

# --- gates -------------------------------------------------------------------
secrets=enforce
# TODO: introduce prettier. Held back because a first run reformats the whole
# codebase, which would bury any review it lands next to. Do it as its own
# commit after SNRGY-4589, then set format=enforce.
format=observe
format_until=2026-10-31
format_why="no formatter configured, only .editorconfig; adopting prettier would reformat the whole codebase - decide after SNRGY-4589"
# TODO: introduce angular-eslint with a frozen baseline, so the gate reports
# new findings instead of the backlog. Own commit after SNRGY-4589, then
# lint=enforce.
lint=observe
lint_until=2026-10-31
lint_why="no eslint configured; introduce angular-eslint with a frozen baseline after SNRGY-4589"
typecheck=enforce
build=enforce
test=enforce
# `npm test` runs `ng test`, which watches and never returns - the runner would
# time out on it. Same command the CI workflows use.
test_cmd="npm test -- --watch=false --browsers=ChromeHeadless"
coverage_delta=observe
coverage_delta_until=2026-11-30
coverage_delta_why="karma-coverage is installed but no baseline or delta tooling exists yet"
deps_license=warn
deps_license_until=2026-10-31
deps_license_why="a local licensing hook guards new code; a manifest check in CI is still missing"
vulns=warn
vulns_until=2026-10-31
vulns_why="production dependencies are clean; the 13 high advisories left sit in the build and test toolchain (@angular-devkit/build-angular, karma) and clear only with an upstream release. Deadline tracks flipping continue-on-error in ci.yml"
# Scope the audit to what ships, matching the CI step. The adapter default also
# audits dev dependencies, which fails on toolchain advisories we cannot act on.
vulns_cmd="npm audit --omit=dev --audit-level=high"

# --- path intensity ------------------------------------------------------------
CRITICAL_PATHS='src/app/auth/* src/app/core/services/auth/*'
RELAXED_PATHS='*.md'

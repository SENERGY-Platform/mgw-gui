# Quality gate configuration for mgw-gui.
# Modes per gate: off | observe | warn | enforce. Every mode below enforce
# carries a date and a reason. Confirmed 2026-08-19 during the next-gen UI
# migration.

# --- gates -------------------------------------------------------------------
secrets=enforce
format=enforce
lint=enforce
typecheck=enforce
# The root tsconfig.json is a base config with no include, so a bare
# `tsc --noEmit` pulls in every @types package and trips over the conflict
# between @types/eslint-scope and eslint's own bundled types. Check the two
# real projects instead.
typecheck_cmd="npx --no-install tsc -p tsconfig.app.json --noEmit && npx --no-install tsc -p tsconfig.spec.json --noEmit"
build=enforce
test=enforce
# `npm test` runs `ng test`, which watches and never returns - the runner would
# time out on it. Same command the CI workflows use. Drives a real Chromium
# through Playwright (needed for the layout- and canvas-dependent specs);
# run `npx playwright install chromium` once per machine before this works -
# `npm install` fetches the package but not the browser binary.
test_cmd="npm test -- --watch=false --browsers=ChromiumHeadless"
coverage_delta=warn
coverage_delta_until=2026-11-30
coverage_delta_why="threshold raised to 50% on 2026-08-24 with changed lines measured at 59.9%; blocking once it has survived a few changes at that level"
# Runs the suite once more with instrumentation, then compares the lcov report
# against the diff to the base ref. The threshold is meant to be raised
# deliberately, as a visible change to this line: 30% at the start, 50% since
# 2026-08-24 (the telemetry and feedback work took changed lines from 35% to
# 59.9%). Kept below the measured rate so the next change has room rather than
# inheriting a gate that only the previous one could pass.
coverage_delta_cmd="npm test -- --watch=false --browsers=ChromiumHeadless --coverage && python3 scripts/coverage-delta.py --min 50"
deps_license=warn
deps_license_until=2026-10-31
deps_license_why="checked in CI and locally, but not blocking there yet; flip continue-on-error in ci.yml on the date"
# Sources the allow list rather than repeating it, so this and the commit hook
# cannot drift apart. --excludePrivatePackages: license-checker calls every
# private package UNLICENSED whatever its license field says, and the scan
# includes this repository's own root package.
deps_license_cmd='. .claude/license-policy.env && license-checker --production --excludePrivatePackages --onlyAllow "$ALLOWED_NPM"'
vulns=enforce
# Scope the audit to what ships, matching the CI step. The adapter default also
# audits dev dependencies, which fails on toolchain advisories we cannot act on.
vulns_cmd="npm audit --omit=dev --audit-level=high"

# --- path intensity ------------------------------------------------------------
CRITICAL_PATHS='src/app/auth/* src/app/core/services/auth/*'
RELAXED_PATHS='*.md'
